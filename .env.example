# ProcureFlow AI Configuration
# Set to 'sqlite:///./data/procureflow.db' for local 0-cost usage or PostgreSQL URL for production
DATABASE_URL=sqlite:///./data/procureflow.db

# Vector Index Storage
FAISS_INDEX_PATH=./data/faiss_index.bin
FAISS_METADATA_PATH=./data/faiss_metadata.json

# Model provider: 'mock' (100% free offline deterministic reasoning), 'claude', or 'ollama'
LLM_PROVIDER=mock

# Anthropic Claude API (Optional - only required if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Embedding Model (defaults to local all-MiniLM-L6-v2, completely free and runs on CPU)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Server Port and Host
HOST=0.0.0.0
PORT=8000

# High-Risk Approval Threshold (in USD or severity score)
HIGH_RISK_REFUND_THRESHOLD=100.0

